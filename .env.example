# База данных
DATABASE_URL="postgresql://user:password@localhost:5432/gco_trainer"
DIRECT_URL="postgresql://user:password@localhost:5432/gco_trainer"

# Основной ИИ: "gemini" (есть бесплатный лимит), "anthropic" или "openai".
# Остальные провайдеры с заданным ключом — запасные: если основной не ответил
# (например, закончился бесплатный лимит Gemini), запрос уходит следующему.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-5-5"
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Проверка открытых ответов: "ai" (по умолчанию) или "keyword" (без ИИ)
GRADING_MODE="ai"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Почта для пересылки обратной связи (опционально)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Куда отправлять обратную связь (раздел 19 ТЗ)
FEEDBACK_EMAIL="mirkomilovjavohir562@gmail.com"

# Секрет для одноразового создания суперадминистратора через браузер
# (альтернатива команде "npx prisma db seed" для тех, кому неудобно с терминалом)
SETUP_SECRET=""

# Хранилище файлов для презентаций (PowerPoint и PDF больше 4 МБ). Vercel добавляет само при подключении Blob.
# BLOB_READ_WRITE_TOKEN=""
