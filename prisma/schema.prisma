// Единая схема данных. Вход по логину и паролю обязателен для всех пользователей
// с первого дня (см. запрос на полную реализацию авторизации, ролей, экспорта
// и ИИ-проверки по загруженным материалам).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // обычные запросы приложения — через Transaction pooler
  directUrl = env("DIRECT_URL")   // только для миграций — через Session pooler
}

enum Role {
  EMPLOYEE
  ADMIN        // расширенные права, но не полный доступ суперадминистратора
  SUPERADMIN   // единственная запись — username "javokhir", создание других запрещено на уровне приложения
}

enum Level {
  BEGINNER
  MIDDLE
  PROFESSIONAL
  EXAM
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN
  FIND_ERROR       // п.4 тип 2: найди ошибку в сообщении
  FIX_MESSAGE      // п.4 тип 3: исправь сообщение
  BEST_RESPONSE    // п.4 тип 4: выбери лучший вариант из нескольких
}

enum MaterialStatus {
  PENDING     // документ загружен, текст ещё не извлечён/не проанализирован
  ANALYZING   // ИИ сейчас читает документ и строит базу знаний (Topic/Rule)
  PROCESSED   // база знаний готова, можно генерировать вопросы
  FAILED
}

model User {
  id            String   @id @default(cuid())
  name          String   // отображаемое имя
  username      String   @unique // логин для входа
  passwordHash  String   // bcrypt-хеш пароля — обязателен для всех, включая суперадминистратора
  role          Role     @default(EMPLOYEE)
  createdAt     DateTime @default(now())

  attempts        TestAttempt[]
  achievements    UserAchievement[]
  leaderboard     LeaderboardEntry?
  feedback        Feedback[]
  weakTopics      WeakTopic[]
}

model Material {
  id           String         @id @default(cuid())
  title        String
  type         String // pdf | docx | txt | link
  filePath     String?
  sourceUrl    String?
  content      String? // извлеченный текст документа — источник для ИИ
  status       MaterialStatus @default(PENDING)
  uploadedBy   String // userId суперадминистратора
  createdAt    DateTime       @default(now())

  version      Int            @default(1)
  supersedesId String?
  supersedes   Material?      @relation("MaterialVersions", fields: [supersedesId], references: [id])
  supersededBy Material[]     @relation("MaterialVersions")
  isActive     Boolean        @default(true)

  questions Question[]
  topics    Topic[]
}

model Topic {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())

  rules     Rule[]
  questions Question[]
  gameItems GameItem[]
}

enum RuleType {
  REQUIRED
  FORBIDDEN
  RECOMMENDED
  EXAMPLE_GOOD
  EXAMPLE_BAD
}

model Rule {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  type        RuleType
  text        String
  sourceQuote String?
  createdAt   DateTime @default(now())

  questions Question[]
}

model Question {
  id               String       @id @default(cuid())
  type             QuestionType
  level            Level
  text             String
  options          Json?
  correctIndex     Int?
  expectedKeywords Json?
  modelAnswer      String?   // эталонный ответ для открытых заданий (показывается в разборе, по нему проверяет ИИ)
  explanation      String?
  image            String?   // скриншот к вопросу (data URL, сжимается в браузере перед загрузкой)
  archivedAt       DateTime? // вопрос в архиве: в тесты не попадает, но его можно вернуть

  sourceMaterialId String?
  sourceMaterial   Material? @relation(fields: [sourceMaterialId], references: [id])

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])
  ruleId  String?
  rule    Rule?   @relation(fields: [ruleId], references: [id])

  createdAt DateTime @default(now())

  answers Answer[]
}

model TestAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  level      Level
  candies    Int
  questionIds Json?    // порядок вопросов, выданных в этой попытке (для разбора и проверки)
  durationSec Int      @default(900) // время на тест, действовавшее в момент старта
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  answers Answer[]
}

model Answer {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       TestAttempt @relation(fields: [attemptId], references: [id])
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])
  rawAnswer     String?
  isCorrect     Boolean
  spellingErrors Int        @default(0)
  grammarErrors  Int        @default(0)
  aiComment     String?
  reviewedAt    DateTime?   // ответ проверен администратором вручную
  reviewedBy    String?     // id администратора, который проверил
  createdAt     DateTime    @default(now())
}

model WeakTopic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  topic     String
  createdAt DateTime @default(now())
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  achievementId String
  earnedAt      DateTime @default(now())

  @@unique([userId, achievementId])
}

model LeaderboardEntry {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  testsDone Int      @default(0)
  avgCandy  Float    @default(0)
  bestCandy Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  description String
  screenshotUrl String?
  createdAt   DateTime @default(now())
}

model Changelog {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// Обучение: готовые презентации, которые загружает администратор (PDF).
model Presentation {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileName    String
  data        Bytes    // сам PDF (до ~4 МБ — лимит запроса Vercel)
  size        Int
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

enum GameKind {
  TRUE_FALSE // «Можно или нельзя?»: фраза сотрудника клиенту — допустима или нет
  FLASHCARD  // «Карточки»: ситуация → правильное поведение
}

// Элемент обучающей игры. Создаётся ИИ по правилам темы или вручную администратором.
model GameItem {
  id          String   @id @default(cuid())
  kind        GameKind
  prompt      String   // фраза (TRUE_FALSE) или ситуация (FLASHCARD)
  answer      String?  // обратная сторона карточки (FLASHCARD)
  isCorrect   Boolean? // можно ли так сказать (TRUE_FALSE)
  explanation String?  // почему — со ссылкой на правило
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}
